@page
@using Newtonsoft.Json
@using _0_Framework.Application
@model ServiceHost.Areas.Admin.Pages.IndexModel
@{
    ViewData["title"] = "پنل ادمین";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title">داشبورد گزارشات</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-sm-6 col-lg-3">
        <div class="mini-stat clearfix bx-shadow">
            <span class="mini-stat-icon bg-info">
                <i class="ion-social-usd"></i>
            </span>
            <div class="mini-stat-info text-right text-muted">
                <span class="counter">@Model.Kpis.TotalRevenue.ToMoney().ToPersianNumber()</span>
                فروش کل (تومان)
            </div>
            @* <div class="tiles-progress"> *@
            @*     <div class="m-t-20"> *@
            @*         <h5 class="text-uppercase">Sales <span class="pull-right">60%</span></h5> *@
            @*         <div class="progress progress-sm m-0"> *@
            @*             <div class="progress-bar progress-bar-info" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" style="width: 60%;"> *@
            @*                 <span class="sr-only">60% Complete</span> *@
            @*             </div> *@
            @*         </div> *@
            @*     </div> *@
            @* </div> *@
        </div>
    </div>

    <div class="col-md-6 col-sm-6 col-lg-3">
        <div class="mini-stat clearfix bx-shadow">
            <span class="mini-stat-icon bg-purple">
                <i class="ion-ios7-cart"></i>
            </span>
            <div class="mini-stat-info text-right text-muted">
                <span class="counter">@Model.Kpis.TotalOrders.ToString().ToPersianNumber()</span>
                کل سفارشات
            </div>
            @* <div class="tiles-progress"> *@
            @*     <div class="m-t-20"> *@
            @*         <h5 class="text-uppercase">Orders <span class="pull-right">90%</span></h5> *@
            @*         <div class="progress progress-sm m-0"> *@
            @*             <div class="progress-bar progress-bar-purple" role="progressbar" aria-valuenow="90" aria-valuemin="0" aria-valuemax="100" style="width: 90%;"> *@
            @*                 <span class="sr-only">90% Complete</span> *@
            @*             </div> *@
            @*         </div> *@
            @*     </div> *@
            @* </div> *@
        </div>
    </div>

    <div class="col-md-6 col-sm-6 col-lg-3">
        <div class="mini-stat clearfix bx-shadow">
            <span class="mini-stat-icon bg-success">
                <i class="ion-eye"></i>
            </span>
            <div class="mini-stat-info text-right text-muted">
                <span class="counter">@Model.Kpis.TotalProductViews.ToString().ToPersianNumber()</span>
                کل بازدیدها از محصولات
            </div>
            @* <div class="tiles-progress"> *@
            @*     <div class="m-t-20"> *@
            @*         <h5 class="text-uppercase">Visitors <span class="pull-right">60%</span></h5> *@
            @*         <div class="progress progress-sm m-0"> *@
            @*             <div class="progress-bar progress-bar-success" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" style="width: 60%;"> *@
            @*                 <span class="sr-only">60% Complete</span> *@
            @*             </div> *@
            @*         </div> *@
            @*     </div> *@
            @* </div> *@
        </div>
    </div>

    <div class="col-md-6 col-sm-6 col-lg-3">
        <div class="mini-stat clearfix bx-shadow">
            <span class="mini-stat-icon bg-primary">
                <i class="ion-android-contacts"></i>
            </span>
            <div class="mini-stat-info text-right text-muted">
                <span class="counter">@Model.Kpis.ActiveUsers.ToString().ToPersianNumber()</span>
                کاربران فعال فروشگاه
            </div>
            @* <div class="tiles-progress"> *@
            @*     <div class="m-t-20"> *@
            @*         <h5 class="text-uppercase">Users <span class="pull-right">57%</span></h5> *@
            @*         <div class="progress progress-sm m-0"> *@
            @*             <div class="progress-bar progress-bar-primary" role="progressbar" aria-valuenow="57" aria-valuemin="0" aria-valuemax="100" style="width: 57%;"> *@
            @*                 <span class="sr-only">57% Complete</span> *@
            @*             </div> *@
            @*         </div> *@
            @*     </div> *@
            @* </div> *@
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-6 col-md-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">نمودار فروش ۶ ماه اخیر</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 300px;">
                    <canvas id="lineChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 col-md-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">وضعیت سفارش‌ها</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 300px;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-md-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">تحلیل روند رشد فروش (ماه جاری vs ماه قبل)</h3>
                <div class="pull-right">
                    @{
                        var growth = Model.SalesComparison.GrowthPercentage;
                        var isGrowth = growth >= 0;
                    }
                    <span class="badge @(isGrowth ? "badge-success" : "badge-danger")" style="padding: 8px 12px; font-size: 13px;">
                        <i class="fa @(isGrowth ? "fa-arrow-up" : "fa-arrow-down")"></i> @Math.Abs(growth)%
                        @(isGrowth ? "رشد" : "کاهش")
                    </span>
                </div>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 300px;">
                    <canvas id="comparisonChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4 col-sm-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">نرخ تبدیل (Conversion)</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div class="conversion-wrapper" style="position: relative; height: 280px; margin-top: 20px;">
                    <canvas id="conversionChart"></canvas>

                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -35%); text-align: center; width: 100%; pointer-events: none;">
                        <h2 style="margin: 0; font-size: 24px; font-weight: bold; color: #2d3436;">
                            @Model.ConversionRate.Data[0]%
                        </h2>
                        <p style="margin: 0; font-size: 13px; color: #636e72;">موفقیت خرید</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<div class="row">
    <div class="col-md-6 col-sm-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">سهم فروش برندهای برتر</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 300px;">
                    <canvas id="topBrandsPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-sm-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">سهم فروش گروه‌های محصول</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 300px;">
                    <canvas id="topCategoriesPieChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="row">
    <div class="col-sm-12">
        <div class="portlet shadow-sm">
            <div class="portlet-heading">
                <h3 class="portlet-title text-dark">۵ محصول پرفروش (تعداد فروش)</h3>
                <div class="clearfix"></div>
            </div>
            <div class="portlet-body">
                <div style="height: 250px;">
                    <canvas id="topProductsChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        Chart.defaults.font.family = 'Tahoma, "Segoe UI", Arial';
        Chart.defaults.font.size = 12;

        const formatMoney = (val) => new Intl.NumberFormat('fa-IR').format(val) + ' تومان';
        const formatNumber = (val) => new Intl.NumberFormat('fa-IR').format(val);

        const monthlySalesRaw = @Html.Raw(JsonConvert.SerializeObject(Model.MonthlySalesChart));
        const orderStatusRaw = @Html.Raw(JsonConvert.SerializeObject(Model.OrderStatusChart));
        const topProductsRaw = @Html.Raw(JsonConvert.SerializeObject(Model.TopProductsChart));
        const compData = @Html.Raw(JsonConvert.SerializeObject(Model.SalesComparison));
        const convData = @Html.Raw(JsonConvert.SerializeObject(Model.ConversionRate));
        const topBrandsRaw = @Html.Raw(JsonConvert.SerializeObject(Model.TopBrandsChart));
        const topCategoriesRaw = @Html.Raw(JsonConvert.SerializeObject(Model.TopCategoriesChart));

        const pieOptions = (title) => ({
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom', rtl: true, labels: { usePointStyle: true } },
                tooltip: {
                    rtl: true,
                    callbacks: {
                        label: function(ctx) {
                            let total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                            let percentage = ((ctx.parsed / total) * 100).toFixed(1) + '%';
                            return ctx.label + ': ' + formatMoney(ctx.parsed) + ' (' + percentage + ')';
                        }
                    }
                }
            }
        });

        new Chart(document.getElementById("lineChart"), {
            type: "bar",
            data: {
                labels: monthlySalesRaw[0].labels,
                datasets: monthlySalesRaw.map(ds => ({
                    label: ds.label,
                    data: ds.data,
                    borderColor: ds.borderColor,
                    backgroundColor: ds.backgroundColor[0],
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.8,
                    categoryPercentage: 0.7
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: {
                    mode: 'index',
                    intersect: false
                },
                plugins: {
                    legend: {
                        display: true,
                        rtl: true,
                        position: 'top',
                        labels: { padding: 20, usePointStyle: true }
                    },
                    tooltip: {
                        rtl: true,
                        padding: 15,
                        callbacks: {
                            label: function(ctx) {
                                return ctx.dataset.label + ': ' + formatMoney(ctx.parsed.y);
                            },
                            afterTitle: function(context) {
                                if (context.length > 1) {
                                    let current = context[0].parsed.y;
                                    let previous = context[1].parsed.y;

                                    if (previous > 0) {
                                        let diff = ((current - previous) / previous * 100).toFixed(1);
                                        let sign = diff >= 0 ? '▲ +' : '▼ ';
                                        return 'اختلاف با پارسال: ' + sign + diff + '%';
                                    }
                                }
                                return '';
                            }
                        },
                        footerFont: { size: 13, weight: 'bold' },
                        footerColor: '#ffcc00'
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { ticks: { callback: (v) => formatNumber(v) } }
                }
            }
        });

        new Chart(document.getElementById("orderStatusChart"), {
            type: "doughnut",
            data: {
                labels: orderStatusRaw.labels,
                datasets: [{ data: orderStatusRaw.data, backgroundColor: orderStatusRaw.backgroundColor }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { rtl: true, position: 'right' },
                    tooltip: { rtl: true, callbacks: { label: (ctx) => ctx.label + ': ' + formatNumber(ctx.parsed) + ' سفارش' } }
                }
            }
        });

        new Chart(document.getElementById("comparisonChart"), {
            type: 'bar',
            data: {
                labels: compData.labels,
                datasets: [{
                    data: [compData.previousValue, compData.currentValue],
                    backgroundColor: ['#b2bec3', '#0984e3'],
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.8,
                    categoryPercentage: 0.7
                }]
            },
            options: {
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { rtl: true, callbacks: { label: (ctx) => formatMoney(ctx.parsed.y) } }
                },
                scales: {
                    x: { grid: { display: false } },
                    y: { ticks: { callback: (v) => formatNumber(v) } }
                }
            }
        });

        new Chart(document.getElementById("conversionChart"), {
            type: 'doughnut',
            data: {
                labels: convData.labels,
                datasets: [{ data: convData.data, backgroundColor: convData.backgroundColor }]
            },
            options: {
                cutout: '80%',
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { rtl: true, callbacks: { label: (ctx) => ctx.label + ': ' + formatNumber(ctx.parsed) + ' %' } }
                }
            }
        });

        new Chart(document.getElementById("topProductsChart"), {
            type: "bar",
            data: {
                labels: topProductsRaw.labels,
                datasets: [{
                    data: topProductsRaw.data,
                    backgroundColor: topProductsRaw.backgroundColor,
                    borderWidth: 1,
                    borderRadius: 5,
                    barPercentage: 0.7,
                    categoryPercentage: 0.6 }]
            },
            options: {
                indexAxis: 'y',
                responsive: true, maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { rtl: true, callbacks: { label: (ctx) => 'فروش: ' + formatNumber(ctx.parsed.x) } }
                },
                scales: {
                    x: { beginAtZero: true, callback: (v) => formatNumber(v) },
                    y: { grid: { display: false } } }
            }
        });

        if (topBrandsRaw) {
            new Chart(document.getElementById("topBrandsPieChart"), {
                type: 'doughnut',
                data: {
                    labels: topBrandsRaw.labels,
                    datasets: [{ data: topBrandsRaw.data, backgroundColor: topBrandsRaw.backgroundColor }]
                },
                options: pieOptions()
            });
        }

        if (topCategoriesRaw) {
            new Chart(document.getElementById("topCategoriesPieChart"), {
                type: 'doughnut',
                data: {
                    labels: topCategoriesRaw.labels,
                    datasets: [{
                        data: topCategoriesRaw.data,
                        backgroundColor: topCategoriesRaw.backgroundColor
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', rtl: true, labels: { usePointStyle: true } },
                        tooltip: {
                            rtl: true,
                            callbacks: {
                                label: function(ctx) {
                                    let value = ctx.parsed;
                                    let total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                    let percentage = ((value / total) * 100).toFixed(1) + '%';

                                    return ctx.label + ': ' + formatNumber(value) + ' عدد (' + percentage + ')';
                                }
                            }
                        }
                    }
                }
            });
        }
    </script>
}