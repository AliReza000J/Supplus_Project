@page
@using _0_Framework.Application

@model ServiceHost.Areas.Admin.Pages.Shop.Tickets.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت تیکت‌ها";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left"></p>
    </div>
</div>

<div class="row" >
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در تیکت‌ها</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Username"></label>
                        <input class="form-control" asp-for="SearchModel.Username" placeholder="نام کاربر">
                    </div>
                    <div class="form-group m-l-6">
                        <input type="checkbox" asp-for="SearchModel.ShowPendingOnly" class="form-check-input" />
                        <label class="form-check-label" asp-for="SearchModel.ShowPendingOnly">نمایش پاسخ داده شده ها</label>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست تیکت‌ها (@Model.Tickets.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered centered-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>نام کاربر</th>
                                    <th>عنوان</th>
                                    <th>متن</th>
                                    <th>تاریخ ارسال تیکت</th>
                                    <th>وضعیت</th>
                                    <th>تاریخ ارسال پاسخ</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Tickets)
                                {
                                    <tr class="@(!item.IsAnswered ? "pending-row" : "" )">
                                        <td>@item.Id</td>
                                        <td>@item.Username</td>
                                        <td class="message-cell">
                                            @(item.Subject.Length > 10 ? item.Subject.Substring(0, 10) + "..." : item.Subject)
                                            <span class="full-message">@item.Subject</span>
                                        </td>
                                        <td class="message-cell">
                                            @(item.Message.Length > 40 ? item.Message.Substring(0, 40) + "..." : item.Message)
                                            <span class="full-message">@item.Message</span>
                                        </td>
                                        <td>@item.CreationDate</td>
                                        <td>@(item.IsAnswered ? "بررسی شده" : "بدون پاسخ")</td>
                                        @if(item.IsAnswered)
                                        {
                                            <td>@item.AdminReplyDate</td>
                                        }
                                        else
                                        {
                                            <td>"-"</td>
                                        }
                                        <td>
                                            <a class="btn btn-warning waves-effect waves-light"
                                               href="#showmodal=@Url.Page("./Index", "Details", new { id = item.Id })">
                                                <i class="fa fa-eye"></i> مشاهده و پاسخ
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable({
                order: [[0, 'desc']]
            });
        });
    </script>
}