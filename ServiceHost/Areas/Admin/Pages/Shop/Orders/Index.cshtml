@page
@using ShopManagement.Configuration.Permissions
@using ShopManagement.Domain.OrderAgg
@using _0_Framework.Application
@model ServiceHost.Areas.Admin.Pages.Shop.Orders.IndexModel
@{
}

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت سفارشات";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.SearchOrders">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در سفارشات</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.AccountId"></label>
                        <select class="form-control" asp-for="SearchModel.AccountId" asp-items="Model.Accounts">
                            <option value="0">انتخاب کاربر خریدار ...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label asp-for="SearchModel.Status">جستجو بر اساس وضعیت سفارش</label>
                        <select class="form-control" asp-for="SearchModel.Status" asp-items="Model.Statuses">
                            <option value="-1">انتخاب وضعیت پرداخت ...</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.ListOrders" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست سفارشات (@Model.Orders?.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered centered-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>نام سفارش دهنده</th>
                                    <th>شماره موبایل</th>
                                    <th>مبلغ نهایی</th>
                                    <th>نحوه پرداخت</th>
                                    <th>شناسه خرید</th>
                                    <th>تاریخ خرید</th>
                                    <th>وضعیت</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Orders)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>@item.RecieverFullName</td>
                                        <td>@item.RecieverMobile?.ToPersianNumber()</td>
                                        <td>@item.PayAmount.ToMoney().ToPersianNumber()</td>
                                        <td>@item.PaymentMethod</td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(item.RefNumber))
                                            {
                                                <span title="کد پیگیری بانکی">
                                                    <i class="fa fa-bank"></i>
                                                    @item.RefNumber?.ToPersianNumber()
                                                </span>
                                            }
                                        </td>
                                        <td>@item.CreationDate?.ToPersianNumber()</td>
                                        <td>
                                            <span> @OrderStatus.GetStatusTitleByCode(item.Status)</span>
                                        </td>
                                        <td>
                                            <a Permission="@ShopPermissions.ActionOrders"
                                               class="btn btn-warning pull-right m-rl-5"
                                               asp-page="./Details"
                                               asp-route-id="@item.Id">
                                                جزئیات
                                            </a>
                                            <a Permission="@ShopPermissions.ActionOrders"
                                               class="btn btn-primary pull-right m-rl-5"
                                               href="#showmodal=@Url.Page("./Index", "Items", new {id = item.Id})"
                                               onclick="$('.modal-dialog').css('width', '60%')">
                                                <i class="fa fa-id-card"></i> آیتم ها
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#datatable').dataTable();
        });
    </script>
}