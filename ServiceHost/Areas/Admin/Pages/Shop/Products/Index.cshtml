@page
@using ShopManagement.Configuration.Permissions
@using _0_Framework.Application

@model ServiceHost.Areas.Admin.Pages.Shop.Products.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت محصولات";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left">
            <a Permission="@ShopPermissions.CreateProduct"
                class="btn btn-success btn-lg" asp-page="./Create">ایجاد محصول جدید</a>
        </p>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.SearchProducts">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در محصولات</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Name"></label>
                        <input class="form-control" asp-for="SearchModel.Name" placeholder="نام محصول">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Code"></label>
                        <input class="form-control" asp-for="SearchModel.Code" placeholder="کد">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Brand"></label>
                        <input class="form-control" asp-for="SearchModel.Brand" placeholder="برند (لاتین - فارسی)">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.CategoryId"></label>
                        <select class="form-control select2-init" asp-for="SearchModel.CategoryId" asp-items="Model.ProductCategories"
                                data-placeholder="انتخاب و یا جستجوی گروه محصول ...">
                            <option value=""></option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.ListProducts" id="ProductCategoriesDiv">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست محصولات (@Model.Products.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <table id="datatable" class="table table-striped table-bordered centered-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>عکس</th>
                                    <th>نام</th>
                                    <th>کد</th>
                                    <th>برند (لاتین - فارسی)</th>
                                    <th>گروه</th>
                                    <th>تاریخ تولید</th>
                                    <th>تعداد کل بازدیدها</th>
                                    <th>عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Products)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td>
                                            <img src="~/Pictures/@item.Picture" style="width: 70px; height: 70px" />
                                        </td>
                                        <td class="message-cell">
                                            @(item.Name.Length > 50 ? item.Name.Substring(0, 50) + "..." : item.Name)
                                            <span class="full-message">@item.Name</span>
                                        </td>
                                        <td>@item.Code</td>
                                        <td>@item.Brand</td>
                                        <td>@item.Category</td>
                                        <td>@item.CreationDate</td>
                                        <td>@item.ViewCount.ToString().ToPersianNumber()</td>
                                        <td>
                                            <a Permission="@ShopPermissions.EditProduct"
                                                class="btn btn-warning pull-right m-rl-5" asp-page="./Edit" asp-route-id="@item.Id">
                                                <i class="fa fa-edit"></i> ویرایش
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable();
        });
    </script>
}