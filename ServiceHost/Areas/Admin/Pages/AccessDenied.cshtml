@page
@model AccessDeniedModel
@{
    Layout = null; // اگر می‌خوای بدون Layout بیاد. می‌تونی حذفش کنی تا از Layout اصلی استفاده کنه.
    ViewData["Title"] = "دسترسی غیرمجاز";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;600&display=swap" rel="stylesheet">
    <style>
        body {
            background: linear-gradient(135deg, #ff4d4d, #ff9999);
            font-family: 'Vazirmatn', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            color: #fff;
        }

        .card {
            background: rgba(255, 255, 255, 0.1);
            border: none;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            padding: 40px;
            text-align: center;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
        }

        .card h1 {
            font-size: 4rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .card p {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
        }

        .btn-custom {
            background-color: #fff;
            color: #ff4d4d;
            font-weight: 600;
            border-radius: 50px;
            padding: 10px 30px;
            transition: all 0.3s ease-in-out;
        }

        .btn-custom:hover {
            background-color: #ff4d4d;
            color: #fff;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
        }
    </style>
</head>
<body>
    <div class="card text-center">
        <h1>🚫</h1>
        <h2>دسترسی غیرمجاز</h2>
        <p>شما مجاز به مشاهده این صفحه نیستید.</p>
        <a href="/admin" class="btn btn-custom">بازگشت به صفحه اصلی</a>
    </div>
</body>
</html>
