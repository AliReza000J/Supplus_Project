@page
@model Areas.Admin.Pages.Comments.IndexModel
@{
}

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت کامنت ها";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group m-l-10">
                        <input class="form-control" asp-for="SearchModel.Username" placeholder="نام کاربر" />
                    </div>
                    <div class="form-group m-l-8">
                        <select class="form-control" asp-for="SearchModel.Rate">
                            <option value="">امتیاز (1 تا 5) </option>
                            <option value="1">1</option>
                            <option value="2">2</option>
                            <option value="3">3</option>
                            <option value="4">4</option>
                            <option value="5">5</option>
                        </select>
                    </div>
                    <div class="form-group m-l-6">
                        <select class="form-control" asp-for="SearchModel.Type">
                            <option value="">نوع</option>
                            <option value="1">محصول</option>
                            <option value="2">مقاله</option>
                        </select>
                    </div>
                    <div class="form-group m-l-6">
                        <input type="checkbox" asp-for="SearchModel.ShowPendingOnly" class="form-check-input" />
                        <label class="form-check-label" for="SearchModel.ShowPendingOnly">فقط نمایش در انتظارها</label>
                    </div>
                    <button type="submit" class="btn btn-success m-l-10">جستجو</button>
                    <a class="btn btn-primary m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست کامنت ها</h3>
            </div>
            <div class="panel-body">
                <table id="datatable" class="table table-striped table-bordered centered-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>نام</th>
                            <th>نام محصول/مقاله</th>
                            <th>خریدار محصول؟</th>
                            <th>پیام</th>
                            <th>تاریخ آخرین ویرایش</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Comments)
                        {
                            <tr class="@( !item.IsCanceled && !item.IsConfirmed ? "pending-row" : "" )">
                                <td>@item.Id</td>
                                <td>@item.Username</td>
                                <td class="message-cell" title="@item.OwnerName">
                                    @(item.OwnerName.Length > 50 ? item.OwnerName.Substring(0, 50) + "..." : item.OwnerName)
                                    <span class="full-message">@item.OwnerName</span>
                                </td>
                                <td>@(item.IsBuyer ? "بله" : "خیر")</td>
                                <td class="message-cell" title="@item.Message">
                                    @(item.Message.Length > 50 ? item.Message.Substring(0, 50) + "..." : item.Message)
                                    <span class="full-message">@item.Message</span>
                                </td>
                                <td>@item.LastModified</td>
                                <td class="text-center">
                                    @if (item.IsCanceled)
                                    {
                                        <span class="text-danger">رد شده</span>
                                    }
                                    else if (!item.IsConfirmed)
                                    {
                                        <span class="text-warning">در انتظار</span>
                                    }
                                    else
                                    {
                                        <span class="text-success">تایید شده</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.IsCanceled && !item.IsConfirmed)
                                    {
                                        <a asp-page="./Index" asp-page-handler="Confirm" asp-route-id="@item.Id"
                                           class="btn btn-success m-b-5">تایید</a>
                                        <a asp-page="./Index" asp-page-handler="Cancel" asp-route-id="@item.Id"
                                           class="btn btn-danger m-b-5">رد</a>
                                    }
                                    else if (!item.IsCanceled && item.IsConfirmed)
                                    {
                                        <a asp-page="./Details" asp-route-id="@item.Id"
                                           class="btn btn-warning m-b-5">مشاهده کامل و پاسخ</a>
                                        <a asp-page="./Index" asp-page-handler="Cancel" asp-route-id="@item.Id"
                                           class="btn btn-danger m-b-5">رد</a>
                                    }
                                    else if (item.IsCanceled)
                                    {
                                        <a asp-page="./Index" asp-page-handler="Confirm" asp-route-id="@item.Id"
                                           class="btn btn-success m-b-5">تایید</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').DataTable();
        });
    </script>
}
