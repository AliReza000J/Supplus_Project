@model AccountManagement.Application.Contracts.Account.ChangePassword
@{
}

<div class="modal-header">
    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
    <h4 class="modal-title">تغییر کلمه رمز</h4>
</div>

<form asp-page="./Index" asp-page-handler="ChangePassword"
      method="post"
      data-ajax="true"
      data-callback=""
      data-action="Refresh">
    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <input type="text" value="user_being_edited" name="fake_username" readonly style="opacity: 0; position: absolute;">
                    <label asp-for="Password" class="control-label form-label fw-semibold">کلمه عبور</label>
                    <div class="password-input-wrapper">
                        <input type="password"
                               asp-for="Password"
                               class="form-control form-control-lg password-field"
                               placeholder="کلمه عبور"
                               autocomplete="new-password">
                        <span class="password-toggle" aria-label="نمایش یا مخفی کردن رمز">
                            <i class="fa fa-eye-slash"></i>
                        </span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <input type="text" value="user_being_edited" name="fake_username" readonly style="opacity: 0; position: absolute;">
                    <label asp-for="RePassword" class="control-label form-label fw-semibold">تکرار کلمه عبور</label>
                    <div class="password-input-wrapper">
                        <input type="password"
                               asp-for="RePassword"
                               class="form-control form-control-lg password-field"
                               placeholder="تکرار کلمه عبور"
                               autocomplete="new-password">
                        <span class="password-toggle" aria-label="نمایش یا مخفی کردن رمز">
                            <i class="fa fa-eye-slash"></i>
                        </span>
                    </div>
                    <span asp-validation-for="RePassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
            <input type="hidden" asp-for="Id" value="@Model.Id" />
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-default waves-effect" data-dismiss="modal">بستن</button>
            <button type="submit" class="btn btn-info waves-effect waves-light">اعمال تغییر</button>
        </div>
    </div>
</form>