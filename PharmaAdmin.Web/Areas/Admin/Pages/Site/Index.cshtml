@page
@model IndexModel
@{
    ViewData["Title"] = "تنظیمات سایت";
}

<div class="container-fluid">
    <form method="post" enctype="multipart/form-data">
        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">تنظیمات عمومی سایت</h3></div>
            <div class="panel-body">
                <div class="form-group">
                    <div class="checkbox">
                        <label style="font-weight: bold; color: darkred;">
                            <input asp-for="Command.GeneralSetting.IsMaintenanceMode" type="checkbox" />
                            فعال‌سازی حالت تعمیرات (خارج کردن سایت از دسترس کاربران و نمایش صفحه در حال بروزرسانی)
                        </label>
                    </div>
                </div>
                <hr />
                <div class="form-group">
                    <label asp-for="Command.GeneralSetting.CopyrightText">متن کپی‌رایت (فوتر سایت)</label>
                    <input asp-for="Command.GeneralSetting.CopyrightText" class="form-control" placeholder="مثال: تمامی حقوق مادی و معنوی این سایت محفوظ است © 1405" />
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">اطلاعات تماس</h3></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <label asp-for="Command.Contact.Email">ایمیل</label>
                        <input asp-for="Command.Contact.Email" class="form-control" />
                        <span asp-validation-for="Command.Contact.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Command.Contact.WorkingHours">ساعات کاری</label>
                        <input asp-for="Command.Contact.WorkingHours" class="form-control" placeholder="مثال: شنبه تا چهارشنبه ۹ الی ۱۷ - پنجشنبه‌ها ۹ الی ۱۳" />
                    </div>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-md-12">
                        <label asp-for="Command.Contact.Address">آدرس</label>
                        <input asp-for="Command.Contact.Address" class="form-control" />
                    </div>
                </div>
                <div class="row" style="margin-top: 15px;">
                    <div class="col-md-6">
                        <label asp-for="Command.Contact.Latitude">عرض جغرافیایی نقشه (Latitude)</label>
                        <input asp-for="Command.Contact.Latitude" class="form-control" placeholder="مثال: 35.689198" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Command.Contact.Longitude">طول جغرافیایی نقشه (Longitude)</label>
                        <input asp-for="Command.Contact.Longitude" class="form-control" placeholder="مثال: 51.388973" />
                    </div>
                </div>
                <hr />
                <h5>شماره‌های تماس</h5>
                <div id="phones-container">
                    @for (int i = 0; i < Model.Command.Contact.Phones.Count; i++)
                    {
                        <div class="row phone-item" style="margin-bottom: 10px;">
                            <div class="col-md-5">
                                <input asp-for="Command.Contact.Phones[i].Title" class="form-control" placeholder="عنوان (مثل: پشتیبانی)" />
                                <span asp-validation-for="Command.Contact.Phones[i].Title"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Command.Contact.Phones[i].Number" class="form-control" placeholder="شماره تماس" />
                                <span asp-validation-for="Command.Contact.Phones[i].Number"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-block remove-phone">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <button type="button" id="add-phone" class="btn btn-info btn-sm mt-2">افزودن شماره تماس</button>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">تصاویر و برندینگ</h3></div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6 text-center">
                        @if (Model.Setting.Logo != null)
                        {
                            <label>لوگو فعلی</label>
                            <div class="thumbnail" style="width: 100px;">
                                <img src="~/Pictures/@Model.Setting.Logo" alt="Logo" class="img-responsive" />
                            </div>
                        }
                        <input asp-for="Command.Branding.LogoFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Command.Branding.LogoFile" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 text-center">
                        @if (Model.Setting.Favicon != null)
                        {
                            <label>فاوآیکون فعلی</label>
                            <div class="thumbnail" style="width: 100px;">
                                <img src="~/Pictures/@Model.Setting.Favicon" alt="Logo" class="img-responsive" />
                            </div>
                        }
                        <input asp-for="Command.Branding.FaviconFile" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Command.Branding.FaviconFile" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">درباره ما</h3></div>
            <div class="panel-body">
                <div class="form-group">
                    <label asp-for="Command.About.Text">متن درباره ما</label>
                    <textarea asp-for="Command.About.Text" class="form-control" rows="5" placeholder="توضیحات سایت را اینجا بنویسید..."></textarea>
                    <span asp-validation-for="Command.About.Text" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">اطلاعات پرداخت (کارت‌های بانکی)</h3>
            </div>
            <div class="panel-body">
                <div id="cards-container">
                    @for (int i = 0; i < Model.Command.Payment.Cards.Count; i++)
                    {
                        <div class="row card-item" style="margin-bottom: 10px;">
                            <div class="col-md-5">
                                <input asp-for="Command.Payment.Cards[i].Owner" class="form-control" placeholder="نام صاحب کارت" />
                                <span asp-validation-for="Command.Payment.Cards[i].Owner"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Command.Payment.Cards[i].Number" class="form-control" placeholder="شماره کارت" />
                                <span asp-validation-for="Command.Payment.Cards[i].Number"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-block remove-card">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <hr />
                <button type="button" id="add-card" class="btn btn-info btn-sm">افزودن کارت جدید</button>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><h3 class="panel-title">قوانین و ضوابط</h3></div>
            <div class="panel-body">
                <div class="form-group">
                    <label>قوانین و مقررات سایت</label>
                    <textarea asp-for="Command.TermsAndConditions.Text" class="form-control" rows="4"></textarea>
                </div>
                <hr />
                <div class="form-group">
                    <label>شرایط و ضوابط مرجوعی کالا</label>
                    <textarea asp-for="Command.ReturnPolicy.Text" class="form-control" rows="4"></textarea>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">شبکه‌های اجتماعی</h3>
            </div>
            <div class="panel-body">
                <div id="socials-container">
                    @for (int i = 0; i < Model.Command.Socials.Items.Count; i++)
                    {
                        <div class="row social-item" style="margin-bottom: 10px;">
                            <div class="col-md-5">
                                <input asp-for="Command.Socials.Items[i].PlatformName" class="form-control" placeholder="نام پلتفرم (مثلا اینستاگرام)" />
                                <span asp-validation-for="Command.Socials.Items[i].PlatformName"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Command.Socials.Items[i].LinkOrId" class="form-control" placeholder="لینک یا آی‌دی بدون @@" />
                                <span asp-validation-for="Command.Socials.Items[i].LinkOrId"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-block remove-social">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <hr />
                <button type="button" id="add-social" class="btn btn-info btn-sm mt-2">افزودن شبکه اجتماعی</button>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">موضوعات تیکت</h3>
            </div>
            <div class="panel-body">
                <div id="titles-container">
                    @for (int i = 0; i < Model.Command.TicketTitles.Titles.Count; i++)
                    {
                        <div class="row title-item" style="margin-bottom: 10px;">
                            <div class="col-md-5">
                                <input asp-for="Command.TicketTitles.Titles[i].TitleName" class="form-control" placeholder="موضوع تیکت" />
                                <span asp-validation-for="Command.TicketTitles.Titles[i].TitleName"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <input asp-for="Command.TicketTitles.Titles[i].NumberOfRow" class="form-control" placeholder="شماره در ترتیب نمایش" />
                                <span asp-validation-for="Command.TicketTitles.Titles[i].NumberOfRow"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-block remove-title">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <hr />
                <button type="button" id="add-title" class="btn btn-info btn-sm mt-2">افزودن موضوع</button>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">سوالات متداول (FAQ)</h3>
            </div>
            <div class="panel-body">
                <div id="faqs-container">
                    @for (int i = 0; i < Model.Command.Faq.Items.Count; i++)
                    {
                        <div class="row faq-item" style="margin-bottom: 10px;">
                            <div class="col-md-10">
                                <input asp-for="Command.Faq.Items[i].Question" class="form-control mb-1" placeholder="سوال" />
                                <span asp-validation-for="Command.Faq.Items[i].Question"
                                      class="text-danger"></span>
                                <textarea asp-for="Command.Faq.Items[i].Answer" class="form-control" rows="2" placeholder="پاسخ"></textarea>
                                <span asp-validation-for="Command.Faq.Items[i].Answer"
                                      class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-danger btn-block remove-faq" style="height: 100%;">حذف</button>
                            </div>
                        </div>
                    }
                </div>
                <hr />
                <button type="button" id="add-faq" class="btn btn-info btn-sm mt-2">افزودن سوال جدید</button>
            </div>
        </div>

        <div class="well">
            <button type="submit" class="btn btn-primary btn-block btn-lg">ذخیره نهایی تمامی تنظیمات</button>
        </div>
    </form>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            $("#add-social").click(function () {
                var index = $(".social-item").length;
                var html = `
                    <div class="row social-item" style="margin-bottom: 10px;">
                        <div class="col-md-5">
                            <input name="Command.Socials.Items[${index}].PlatformName" class="form-control" placeholder="نام پلتفرم" />
                        </div>
                        <div class="col-md-5">
                            <input name="Command.Socials.Items[${index}].LinkOrId" class="form-control" placeholder="لینک یا آی‌دی بدون نماد @@" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-block remove-social">حذف</button>
                        </div>
                    </div>`;
                $("#socials-container").append(html);
            });

            $(document).on("click", ".remove-social", function () {
                $(this).closest(".social-item").remove();
                $(".social-item").each(function (index, element) {
                    $(element).find("input").each(function () {
                        var name = $(this).attr("name");
                        if (name.includes("PlatformName")) $(this).attr("name", `Command.Socials.Items[${index}].PlatformName`);
                        if (name.includes("LinkOrId")) $(this).attr("name", `Command.Socials.Items[${index}].LinkOrId`);
                    });
                });
            });

        });

        $(document).ready(function () {
            $("#add-title").click(function () {
                var index = $(".title-item").length;
                var html = `
                    <div class="row title-item" style="margin-bottom: 10px;">
                        <div class="col-md-5">
                            <input name="Command.TicketTitles.Titles[${index}].TitleName" class="form-control" placeholder="موضوع تیکت" />
                        </div>
                        <div class="col-md-5">
                            <input name="Command.TicketTitles.Titles[${index}].NumberOfRow" class="form-control" placeholder="شماره در ترتیب نمایش" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-block remove-title">حذف</button>
                        </div>
                    </div>`;
                $("#titles-container").append(html);
            });

            $(document).on("click", ".remove-title", function () {
                $(this).closest(".title-item").remove();
                $(".title-item").each(function (index, element) {
                    $(element).find("input").each(function () {
                        var name = $(this).attr("name");
                        if (name.includes("TitleName")) $(this).attr("name", `Command.TicketTitles.Titles[${index}].TitleName`);
                        if (name.includes("NumberOfRow")) $(this).attr("name", `Command.TicketTitles.Titles[${index}].NumberOfRow`);
                    });
                });
            });

        });

        $(document).ready(function () {
            $("#add-card").click(function () {
                var index = $(".card-item").length;
                var html = `
                    <div class="row card-item" style="margin-bottom: 10px;">
                        <div class="col-md-5">
                            <input name="Command.Payment.Cards[${index}].Owner" class="form-control" placeholder="نام صاحب کارت" />
                        </div>
                        <div class="col-md-5">
                            <input name="Command.Payment.Cards[${index}].Number" class="form-control" placeholder="شماره کارت" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-block remove-card">حذف</button>
                        </div>
                    </div>`;
                $("#cards-container").append(html);
            });

            $(document).on("click", ".remove-card", function () {
                $(this).closest(".card-item").remove();
                reIndexCards();
            });

            function reIndexCards() {
                $(".card-item").each(function (index, element) {
                    $(element).find("input").each(function () {
                        var name = $(this).attr("name");
                        if (name.includes("Owner")) $(this).attr("name", `Command.Payment.Cards[${index}].Owner`);
                        if (name.includes("Number")) $(this).attr("name", `Command.Payment.Cards[${index}].Number`);
                    });
                });
            }
        });

        $(document).ready(function () {
            $("#add-phone").click(function () {
                var index = $(".phone-item").length;
                var html = `
                    <div class="row phone-item" style="margin-bottom: 10px;">
                        <div class="col-md-5">
                            <input name="Command.Contact.Phones[${index}].Title" class="form-control" placeholder="عنوان (مثل: پشتیبانی)" />
                        </div>
                        <div class="col-md-5">
                            <input name="Command.Contact.Phones[${index}].Number" class="form-control" placeholder="شماره تماس" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-block remove-phone">حذف</button>
                        </div>
                    </div>`;
                $("#phones-container").append(html);
            });

            $(document).on("click", ".remove-phone", function () {
                $(this).closest(".phone-item").remove();
                $(".phone-item").each(function (index, element) {
                    $(element).find("input").each(function () {
                        var name = $(this).attr("name");
                        if (name.includes("Title")) $(this).attr("name", `Command.Contact.Phones[${index}].Title`);
                        if (name.includes("Number")) $(this).attr("name", `Command.Contact.Phones[${index}].Number`);
                    });
                });
            });
        });

        $(document).ready(function () {
            $("#add-faq").click(function () {
                var index = $(".faq-item").length;
                var html = `
                    <div class="row faq-item" style="margin-bottom: 10px;">
                        <div class="col-md-10">
                            <input name="Command.Faq.Items[${index}].Question" class="form-control mb-1" placeholder="سوال" />
                            <textarea name="Command.Faq.Items[${index}].Answer" class="form-control" rows="2" placeholder="پاسخ"></textarea>
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-block remove-faq" style="height: 100%;">حذف</button>
                        </div>
                    </div>`;
                $("#faqs-container").append(html);
            });

            $(document).on("click", ".remove-faq", function () {
                $(this).closest(".faq-item").remove();
                $(".faq-item").each(function (index, element) {
                    $(element).find("input, textarea").each(function () {
                        var name = $(this).attr("name");
                        if (name.includes("Question")) $(this).attr("name", `Command.Faq.Items[${index}].Question`);
                        if (name.includes("Answer")) $(this).attr("name", `Command.Faq.Items[${index}].Answer`);
                    });
                });
            });
        });

    </script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}