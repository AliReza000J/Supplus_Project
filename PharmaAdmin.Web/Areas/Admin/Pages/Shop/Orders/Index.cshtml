@page
@using ShopManagement.Configuration.Permissions
@using ShopManagement.Domain.OrderAgg
@using _0_Framework.Application
@model PharmaAdmin.Web.Areas.Admin.Pages.Shop.Orders.IndexModel
@{
}

@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت سفارشات";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.SearchOrders">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجو در سفارشات</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.FromDate"></label>
                        <input class="form-control persianDateInput" asp-for="SearchModel.FromDate" placeholder="از تاریخ..." autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.ToDate"></label>
                        <input class="form-control persianDateInput" asp-for="SearchModel.ToDate" placeholder="تا تاریخ..." autocomplete="off">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.UserId"></label>
                        <select class="form-control" asp-for="SearchModel.UserId" asp-items="Model.Accounts">
                            <option value="0">انتخاب کاربر خریدار ...</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Status"></label>
                        <select class="form-control" asp-for="SearchModel.Status" asp-items="Model.Statuses">
                            <option value="-1">انتخاب وضعیت پرداخت ...</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect waves-light m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect waves-light m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row" Permission="@ShopPermissions.ListOrders">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">لیست سفارشات (@Model.Orders?.Count)</h3>
            </div>
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table id="datatable" class="table table-striped table-bordered centered-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>سفارش دهنده</th>
                                        <th>مبلغ نهایی</th>
                                        <th>نحوه پرداخت</th>
                                        <th>شناسه خرید</th>
                                        <th>تاریخ خرید</th>
                                        <th>وضعیت</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Orders)
                                    {
                                        <tr class="@(
                                                item.Status <= OrderStatus.WaitingForManualVerification ? "pending-order" :
                                                item.Status == OrderStatus.NeedsRefund ? "needRefund-order" :
                                                item.Status == OrderStatus.ReturnRequested ? "returnRequest-order" :
                                                item.Status >= OrderStatus.Cancelled ? "cancelled-order" :
                                                item.Status == OrderStatus.Paid ? "paid-order" : "default-order"
                                                )">
                                            <td>@item.Id</td>
                                            <td>@item.ReceiverFullName</td>
                                            <td>@item.PayAmount.ToMoney().ToPersianNumber()</td>
                                            <td>@item.PaymentMethod</td>
                                            <td>
                                                @if (!string.IsNullOrWhiteSpace(item.RefNumber))
                                                {
                                                    <span title="کد پیگیری بانکی">
                                                        <i class="fa fa-bank"></i>
                                                        @item.RefNumber?.ToPersianNumber()
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span style="direction:ltr; unicode-bidi:embed;">
                                                    @item.CreationDate?.ToPersianNumber()
                                                </span>
                                            </td>
                                            <td>
                                                <span>
                                                    @if (item.Status <= OrderStatus.WaitingForManualVerification)
                                                    {
                                                        <span class="m-l-5">⏳</span>
                                                    }
                                                    else if (item.Status == OrderStatus.NeedsRefund)
                                                    {
                                                        <span class="m-l-5">💸</span>
                                                    }
                                                    else if (item.Status == OrderStatus.ReturnRequested)
                                                    {
                                                        <span class="m-l-5">📦</span>
                                                    }
                                                    else if (item.Status >= OrderStatus.Cancelled)
                                                    {
                                                        <span class="m-l-5">❌</span>
                                                    }
                                                    else if (item.Status == OrderStatus.Paid)
                                                    {
                                                        <span class="m-l-5">✅</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="m-l-5">📄</span>
                                                    }

                                                    @OrderStatus.GetStatusTitleByCode(item.Status)
                                                </span>
                                            </td>
                                            <td>
                                                <a Permission="@ShopPermissions.ActionOrders"
                                                   class="btn btn-warning pull-right m-rl-5"
                                                   asp-page="./Details"
                                                   asp-route-id="@item.Id">
                                                    جزئیات
                                                </a>
                                                <a Permission="@ShopPermissions.ActionOrders"
                                                   class="btn btn-primary pull-right m-rl-5"
                                                   href="#showmodal=@Url.Page("./Index", "Items", new {id = item.Id})"
                                                   onclick="$('.modal-dialog').css('width', '60%')">
                                                    <i class="fa fa-id-card"></i> آیتم ها
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            $('#datatable').dataTable({
                order: [[0, 'desc']]
            });
        });
    </script>
}