@page
@using ShopManagement.Configuration.Permissions
@model PharmaAdmin.Web.Areas.Admin.Pages.Shop.Products.EditModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["Title"] = "ویرایش محصول";
}

<div class="row" Permission="@ShopPermissions.EditProduct">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">ویرایش محصول: @Model.Command.Name</h3>
            </div>
            <div class="panel-body">
                <form method="post" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Command.Name" class="control-label">نام</label>
                                <input type="text" class="form-control" id="Name" asp-for="Command.Name">
                                <span asp-validation-for="Command.Name" class="error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Command.Code" class="control-label">کد</label>
                                <input type="text" class="form-control" dir="ltr" asp-for="Command.Code">
                                <span asp-validation-for="Command.Code" class="error"></span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label asp-for="Command.Brand" class="control-label">برند (لاتین - فارسی)</label>
                                <input type="text" class="form-control" asp-for="Command.Brand">
                                <span asp-validation-for="Command.Brand" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Command.CategoryId" class="control-label">گروه محصول</label>
                                <select class="form-control select2-init" asp-for="Command.CategoryId"
                                        asp-items="Model.ProductCategories"
                                        data-placeholder="انتخاب و یا جستجوی گروه محصول ...">
                                    <option value=""></option>
                                </select>
                                <span asp-validation-for="Command.CategoryId" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="Command.Picture" class="control-label">عکس</label>
                                <input type="file" class="form-control" asp-for="Command.Picture" accept="image/*">
                                <span asp-validation-for="Command.Picture" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Command.PictureAlt" class="control-label">Alt</label>
                                <input type="text" class="form-control" asp-for="Command.PictureAlt">
                                <span asp-validation-for="Command.PictureAlt" class="error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Command.PictureTitle" class="control-label">عنوان تصویر</label>
                                <input type="text" class="form-control" asp-for="Command.PictureTitle">
                                <span asp-validation-for="Command.PictureTitle" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group no-margin">
                                <label asp-for="Command.ShortDescription" class="control-label">توضیحات کوتاه (معرفی محصول)</label>
                                <textarea class="form-control autogrow" id="ShortDescription" asp-for="Command.ShortDescription" onchange="fillField('ShortDescription', 'MetaDescription')"
                                          style="overflow: hidden; word-wrap: break-word; resize: vertical; height: 104px;"></textarea>
                                <span asp-validation-for="Command.ShortDescription" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group no-margin">
                                <label asp-for="Command.Description" class="control-label">توضیحات</label>
                                <textarea class="form-control" id="descEditor" asp-for="Command.Description" data-module="Products"></textarea>
                                <span asp-validation-for="Command.Description" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="panel panel-border panel-info">
                                <div class="panel-heading">
                                    <h3 class="panel-title">مشخصات محصول (Specifications)</h3>
                                </div>
                                <div class="panel-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="control-label">کشور سازنده</label>
                                                <input type="text" id="spec-country" class="form-control" placeholder="مثال: ایران">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label class="control-label">شکل محصول</label>
                                                <input type="text" id="spec-form" class="form-control" placeholder="مثال: قرص، شربت">
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    <h5 class="m-b-20">مشخصات پویا</h5>
                                    <div id="dynamic-attributes-container">
                                        <!-- ردیف‌های پویا در اینجا اضافه می‌شوند -->
                                    </div>
                                    <button type="button" id="btn-add-attribute" class="btn btn-info btn-sm m-t-10">
                                        <i class="fa fa-plus"></i> افزودن مشخصه جدید
                                    </button>

                                    <!-- فیلد مخفی برای ارسال کل دیتای JSON به بک‌اند -->
                                    <input type="hidden" asp-for="Command.Specifications" id="hidden-specifications" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Command.Slug" class="control-label">اسلاگ</label>
                                <input type="text" class="form-control" id="Slug" asp-for="Command.Slug">
                                <span asp-validation-for="Command.Slug" class="error"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="Command.Keywords" class="control-label">کلمات کلیدی (با کاما جدا کنید)</label>
                                <input type="text" class="form-control" asp-for="Command.Keywords">
                                <span asp-validation-for="Command.Keywords" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group no-margin">
                                <label asp-for="Command.MetaDescription" class="control-label">توضیحات متا</label>
                                <textarea class="form-control autogrow" id="MetaDescription" asp-for="Command.MetaDescription"
                                          style="overflow: hidden; word-wrap: break-word; resize: vertical; height: 104px;"></textarea>
                                <span asp-validation-for="Command.MetaDescription" class="error"></span>
                            </div>
                        </div>
                    </div>
                    <input type="hidden" asp-for="Command.Id" />
                    <button type="submit" class="btn btn-success waves-effect waves-light m-b-5">ویرایش</button>
                    <a asp-page="./Index" class="btn btn-dark waves-effect waves-light m-b-5">بازگشت</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            const existingSpecVal = $('#hidden-specifications').val();
            let specData = { CountryOfOrigin: '', ProductForm: '', Attributes: {} };

            if (existingSpecVal) {
                try {
                    specData = JSON.parse(existingSpecVal);
                    $('#spec-country').val(specData.CountryOfOrigin || '');
                    $('#spec-form').val(specData.ProductForm || '');

                    if (specData.Attributes) {
                        for (const [key, value] of Object.entries(specData.Attributes)) {
                            addAttributeRow(key, value);
                        }
                    }
                } catch (e) {
                    console.error("خطا در پارس کردن JSON مشخصات.");
                }
            } else {
                addAttributeRow();
            }

            $('#btn-add-attribute').click(function () {
                addAttributeRow();
            });

            $(document).on('click', '.btn-remove-attr', function () {
                $(this).closest('.attr-row').remove();
            });

            function addAttributeRow(key = '', value = '') {
                const rowHtml = `
                    <div class="row attr-row m-b-10">
                        <div class="col-md-5">
                            <input type="text" class="form-control attr-key" placeholder="عنوان (مثال: وزن)" value="${key}" />
                        </div>
                        <div class="col-md-5">
                            <input type="text" class="form-control attr-value" placeholder="مقدار (مثال: 50 گرم)" value="${value}" />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-danger btn-sm btn-remove-attr" style="margin-top: 2px;">حذف</button>
                        </div>
                    </div>
                `;
                $('#dynamic-attributes-container').append(rowHtml);
            }

            $('form').on('submit', function () {
                const finalSpec = {
                    CountryOfOrigin: $('#spec-country').val().trim(),
                    ProductForm: $('#spec-form').val().trim(),
                    Attributes: {}
                };

                $('.attr-row').each(function () {
                    const key = $(this).find('.attr-key').val().trim();
                    const val = $(this).find('.attr-value').val().trim();

                    if (key !== '') {
                        finalSpec.Attributes[key] = val;
                    }
                });

                $('#hidden-specifications').val(JSON.stringify(finalSpec));
            });
        });
    </script>
}