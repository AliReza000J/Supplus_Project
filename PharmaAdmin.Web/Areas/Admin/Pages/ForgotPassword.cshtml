@page
@model PharmaAdmin.Web.Areas.Admin.Pages.ForgotPasswordModel
@{
    Layout = "~/Areas/Admin/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "فراموشی رمز عبور";
}

<div class="login-card text-center">
    <div class="mb-4">
        <h4 class="mt-3 mb-1 text-dark">بازیابی رمز عبور</h4>
        <p class="text-muted small">ایمیل حساب مدیریت خود را وارد کنید</p>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-danger text-center">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="mb-4 text-start">
            <label class="form-label fw-semibold">ایمیل</label>
            <input type="email" asp-for="Command.Email" class="form-control form-control-lg" dir="ltr" required placeholder="admin@example.com" />
            <span asp-validation-for="Command.Email" class="text-danger small mt-1 d-block"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2 fs-5 rounded-3 mb-3">ارسال لینک بازیابی</button>

        <a asp-page="Login" class="text-muted small text-decoration-none forget-pass-link">بازگشت به صفحه ورود</a>
    </form>
</div>