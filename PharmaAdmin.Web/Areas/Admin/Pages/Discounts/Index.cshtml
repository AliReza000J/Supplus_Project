@page
@using _0_Framework.Application
@model PharmaAdmin.Web.Areas.Admin.Pages.Discounts.IndexModel
@{
    Layout = "Shared/_AdminLayout";
    ViewData["title"] = "مدیریت تخفیف‌ها";
}

<div class="row">
    <div class="col-sm-12">
        <h4 class="page-title pull-right">@ViewData["title"]</h4>
        <p class="pull-left">
            <a class="btn btn-success btn-lg" asp-page="./Create">تعریف تخفیف جدید</a>
        </p>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h3 class="panel-title">جستجوی پیشرفته</h3>
            </div>
            <div class="panel-body">
                <form class="form-inline" role="form" method="get">
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Title"></label>
                        <input class="form-control" asp-for="SearchModel.Title" placeholder="عنوان تخفیف">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.CouponCode"></label>
                        <input class="form-control" asp-for="SearchModel.CouponCode" placeholder="کد تخفیف">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.StartDate"></label>
                        <input class="form-control persianDateInput" asp-for="SearchModel.StartDate">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.EndDate"></label>
                        <input class="form-control persianDateInput" asp-for="SearchModel.EndDate">
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.IsActive"></label>
                        <select class="form-control" asp-for="SearchModel.IsActive">
                            <option value="">وضعیت (همه)</option>
                            <option value="true">فقط فعال</option>
                            <option value="false">فقط غیرفعال</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.Type"></label>
                        <select class="form-control" asp-for="SearchModel.Type" asp-items="Model.Types">
                            <option value="">نوع (همه)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="sr-only" asp-for="SearchModel.ApplyType"></label>
                        <select class="form-control" asp-for="SearchModel.ApplyType" asp-items="Model.ApplyTypes">
                            <option value="">نحوه اعمال (همه)</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success waves-effect m-l-10">جستجو</button>
                    <a class="btn btn-primary waves-effect m-l-10" asp-page="./Index">مشاهده همه</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="panel panel-default">
            <div class="panel-body">
                <div class="row">
                    <div class="col-md-12 col-sm-12 col-xs-12">
                        <div class="table-responsive">
                            <table id="datatable" class="table table-striped table-bordered centered-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>عنوان</th>
                                        <th>کد تخفیف</th>
                                        <th>نوع</th>
                                        <th>نحوه اعمال</th>
                                        <th>درصد</th>
                                        <th>وضعیت</th>
                                        <th>تعداد استفاده</th>
                                        <th>تاریخ اتمام</th>
                                        <th>عملیات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Discounts)
                                    {
                                        <tr>
                                            <td>@item.Id.ToString().ToPersianNumber()</td>
                                            <td>@item.Title</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.CouponCode) ? "---" : item.CouponCode.ToPersianNumber())</td>
                                            <td>@item.TypeName</td>
                                            <td>@item.ApplyTypeName</td>
                                            <td><span class="badge badge-success">@item.Percentage.ToString().ToPersianNumber()%</span></td>
                                            <td class="text-center">
                                                @if (item.IsActive)
                                                {
                                                    <i class="fa fa-check text-success fa-2x"></i>
                                                }
                                                else
                                                {
                                                    <i class="fa fa-remove text-danger fa-2x"></i>
                                                }
                                            </td>
                                            <td>@item.UsageCount.ToString().ToPersianNumber()</td>
                                            <td>@item.EndDate.ToPersianNumber()</td>
                                            <td>
                                                <a class="btn btn-warning waves-effect waves-light m-b-5" asp-page="./Edit" asp-route-id="@item.Id">
                                                    <i class="fa fa-edit"></i> ویرایش
                                                </a>
                                                @if (!item.IsActive)
                                                {
                                                    <a asp-page="./Index" asp-page-handler="Activate" asp-route-id="@item.Id"
                                                       class="btn btn-success waves-effect waves-light m-b-5">فعال‌سازی</a>
                                                }
                                                else
                                                {
                                                    <a asp-page="./Index" asp-page-handler="Deactivate" asp-route-id="@item.Id"
                                                       class="btn btn-danger waves-effect waves-light m-b-5">غیرفعال‌سازی</a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/adminTheme/assets/datatables/jquery.dataTables.min.js"></script>
    <script src="~/adminTheme/assets/datatables/dataTables.bootstrap.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $('#datatable').dataTable({
                order: [[0, 'desc']]
            });
        });
    </script>
}