{
  "Security": {
    "ForceHttps": false
  },

  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://supplus.ir",
      "https://admin.supplus.ir"
    ]
  },

  "Jwt": {
    "Issuer": "PharmaPlusShop",
    "Audience": "PharmaPlusShopClients",
    "AccessTokenMinutes": 45,
    "RefreshTokenDays": 3
  },

  "ZibalSettings": {
    "ApiUrl": "https://gateway.zibal.ir/v1/",
    "PaymentPageUrl": "https://gateway.zibal.ir/start/"
  },

  "SmsSettings": {
    "BaseUrl": "https://api.sms.ir/v1/send/verify",
    "Templates": {
      "LoginOtp": 123456,
      "PostTracking": 123456
    }
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Forwarded-For",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "QuotaExceededResponse": {
      "Content": "{{ \"success\": false, \"message\": \"تعداد درخواست‌های شما بیش از حد مجاز است. لطفاً کمی صبر کنید.\", \"data\": null, \"errors\": null }}",
      "ContentType": "application/json",
      "StatusCode": 429
    },
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 50
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 150
      }
    ]
  }
}